# =========================================================
# Clean URL configuration (hide .html extensions)
# =========================================================
RewriteEngine On

# 1. Collapse /index and /index.html to the site root.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?[\ ?] [NC]
RewriteRule ^ / [R=301,L]

# 2. If a request is made directly for a .html file, redirect
#    (301) to the clean URL without the extension.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html[\ ?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Internally serve the matching .html file for clean URLs,
#    without changing what appears in the address bar.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Custom error page
ErrorDocument 404 /404.html

# Default document
DirectoryIndex index.html

# =========================================================
# Security Headers & Configuration
# =========================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set Content-Security-Policy "frame-ancestors 'none'"
    Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
</IfModule>

# Disable directory listing
Options -Indexes
